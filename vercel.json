{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "public/data/*.csv",
      "excludeFiles": "{src/**,dist/**,node_modules/**,.venv/**,.vercel/**,.cache/**,.vite/**,tests/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
