# No environment variables are required for the default browser-side runtime.
#
# The Vercel compute endpoints are optional deployment support. If
# PMT_API_TOKEN is set, /api/mine and /api/layout require the same token from
# the frontend.
# PMT_API_TOKEN=
# VITE_PMT_API_TOKEN=
#
# Security note: VITE_PMT_API_TOKEN is bundled into browser JavaScript. It is
# useful for a protected thesis demo or preview, but it is not a strong secret
# for a public production site.
